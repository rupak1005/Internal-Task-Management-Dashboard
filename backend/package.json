{
  "name": "task-dashboard-backend",
  "version": "1.0.0",
  "description": "Production-ready Node.js + Express + PostgreSQL backend for Internal Task & Management Dashboard",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node utils/seeder.js",
    "test": "node tests/api.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:start": "pg_ctl -D ./data/pgdata -o '-p 5432 -k ./data/pgdata' -l ./data/pgdata/postgres.log start",
    "db:stop": "pg_ctl -D ./data/pgdata stop",
    "db:status": "pg_isready -h localhost -p 5432"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "joi": "^17.13.3",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.11.0"
  }
}
